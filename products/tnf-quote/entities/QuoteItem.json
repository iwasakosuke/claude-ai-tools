{
  "name": "QuoteItem",
  "type": "object",
  "description": "見積明細。line_total はサーバーで数量×単価を四捨五入して確定。",
  "properties": {
    "quote_id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "quantity": { "type": "number", "default": 1 },
    "unit_price": { "type": "number", "default": 0, "description": "税抜単価" },
    "tax_rate": { "type": "number", "default": 0.1 },
    "line_total": { "type": "number", "default": 0, "description": "サーバー計算(税抜)" },
    "sort_order": { "type": "number", "default": 0 },
    "withholding_eligible": { "type": "boolean", "default": true, "description": "源泉徴収の対象品目か" }
  },
  "required": ["quote_id", "name", "quantity", "unit_price", "tax_rate", "sort_order"]
}
